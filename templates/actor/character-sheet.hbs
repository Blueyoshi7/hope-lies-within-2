<form class="{{cssClass}} hlw-sheet hlw-bogen" autocomplete="off">
  <header class="hb-kopf">
    <div class="hb-kopfbild"><img src="{{tokenImage}}" alt="" /></div>
    <div class="hb-ident">
      <input class="hb-name" name="name" type="text" value="{{actor.name}}" placeholder="Name" />
      <div class="hb-chips">
        {{#if isMonster}}
          <span class="hb-chip hb-klasse">{{system.monster.category}} · Rang {{system.monster.rank}}</span>
          <span class="hb-chip">{{system.monster.role}}</span>
          <span class="hb-chip">{{system.monster.size}}</span>
          <span class="hb-chip hb-verhalten" data-verhalten="{{system.monster.behavior}}">{{system.monster.behavior}}</span>
          {{#if system.monster.tameable}}<span class="hb-chip" title="{{system.monster.tamers}}">zähmbar</span>{{/if}}
          {{#if gefaehrteBesitzer}}<span class="hb-chip hb-klasse">Gefährte von {{gefaehrteBesitzer}}</span>{{/if}}
        {{else}}
          {{#if isGM}}
            <label class="hb-chip hb-klasse" title="{{system.derived.suggestedClassEffect}}">
              <select data-klasse-wahl>
                <option value="">{{vorschlagLabel}}</option>
                {{#each klassenGruppen as |gruppe|}}
                  <optgroup label="{{gruppe.kategorie}}">
                    {{#each gruppe.klassen as |k|}}<option value="{{k.name}}" {{#if k.selected}}selected{{/if}}>{{k.label}}</option>{{/each}}
                  </optgroup>
                {{/each}}
              </select>
            </label>
          {{else}}
            <span class="hb-chip hb-klasse" title="{{klasseEffekt}}">{{#if klasseAnzeige}}{{klasseAnzeige}}{{else}}noch keine Klasse{{/if}}</span>
          {{/if}}
          {{#if isGM}}
            <label class="hb-chip">Level <input name="system.progression.level" type="number" min="1" max="40" value="{{system.progression.level}}" /></label>
          {{else}}
            <span class="hb-chip">Level <b>{{system.progression.level}}</b></span>
          {{/if}}
          {{#if punkte.frei}}<button type="button" class="hb-chip hb-punkte-chip" data-zu-den-punkten>{{punkte.frei}} Punkte frei</button>{{/if}}
          <label class="hb-chip">Herkunft <input name="system.identity.origin" type="text" value="{{system.identity.origin}}" placeholder="–" /></label>
          <span class="hb-chip">Kes <b>{{kesText}}</b></span>
        {{/if}}
      </div>
    </div>
    <div class="hb-balken">
      <label class="hb-balkenzeile">
        <span>HP</span>
        <span class="hb-spur"><i class="hb-hp" style="width: {{balken.hp}}%"></i></span>
        <span class="hb-zahl"><input name="system.resources.hp.value" type="number" value="{{system.resources.hp.value}}" /> / {{system.resources.hp.max}}</span>
      </label>
      {{#unless isMonster}}
        <label class="hb-balkenzeile">
          <span>EXP</span>
          <span class="hb-spur"><i class="hb-exp" style="width: {{balken.exp}}%"></i></span>
          <span class="hb-zahl">{{#if isGM}}<input name="system.progression.exp" type="number" value="{{system.progression.exp}}" />{{else}}{{system.progression.exp}}{{/if}} / {{#if system.derived.expNext}}{{system.derived.expNext}}{{else}}max{{/if}}</span>
        </label>
        <label class="hb-balkenzeile">
          <span>Korruption</span>
          <span class="hb-spur"><i class="hb-korr" style="width: {{balken.korruption}}%"></i></span>
          <span class="hb-zahl"><input name="system.resources.corruption.value" type="number" value="{{system.resources.corruption.value}}" /> · {{system.derived.corruption.label}}</span>
        </label>
      {{/unless}}
    </div>
  </header>

  <nav class="sheet-tabs tabs hb-reiter" data-group="primary">
    <a class="item" data-tab="main">Charakter</a>
    <a class="item" data-tab="skills">Skills</a>
    {{#unless isMonster}}<a class="item" data-tab="insignia">Insignien</a>{{/unless}}
    <a class="item" data-tab="notes">Notizen</a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="main">
      <div class="hb-oben">
        {{#if isMonster}}
          <section class="hb-karte hb-monster">
            <h3>Bestiarium</h3>
            <div class="hb-monsterbild"><img src="{{profileImage}}" data-edit="img" alt="" /></div>
            <div class="hb-formular">
              <label>Rang <input name="system.monster.rank" type="text" value="{{system.monster.rank}}" /></label>
              <label>Rolle <input name="system.monster.role" type="text" value="{{system.monster.role}}" /></label>
              <label>Größe <input name="system.monster.size" type="text" value="{{system.monster.size}}" /></label>
              <label>Kategorie <input name="system.monster.category" type="text" value="{{system.monster.category}}" /></label>
              <label>HP <input name="system.monster.hp" type="number" value="{{system.monster.hp}}" /></label>
              <label>RW <input name="system.monster.rw" type="number" value="{{system.monster.rw}}" /></label>
              <label>MR <input name="system.monster.mr" type="number" value="{{system.monster.mr}}" /></label>
              <label>Genauigkeit <input name="system.monster.acc" type="number" value="{{system.monster.acc}}" /></label>
              <label>Initiative <input name="system.monster.initiative" type="number" value="{{system.monster.initiative}}" /></label>
              <label>Bewegung <input name="system.monster.movement" type="number" value="{{system.monster.movement}}" /></label>
              <label>Reichweite <input name="system.monster.reach" type="number" value="{{system.monster.reach}}" /></label>
              <label>Probenwert <input name="system.monster.probe" type="number" value="{{system.monster.probe}}" /></label>
              <label>Corrupted-Stufe <input name="system.monster.corrupted" type="number" value="{{system.monster.corrupted}}" /></label>
              <label>EXP <input name="system.monster.exp" type="text" value="{{system.monster.exp}}" /></label>
              <label>Verhalten
                <select name="system.monster.behavior">
                  {{#select system.monster.behavior}}
                    <option value="friedlich">friedlich</option>
                    <option value="scheu">scheu</option>
                    <option value="territorial">territorial</option>
                    <option value="aggressiv">aggressiv</option>
                  {{/select}}
                </select>
              </label>
              <label>Zähmbar <span class="hb-zaehmbar"><input name="system.monster.tameable" type="checkbox" {{checked system.monster.tameable}} /> {{#if system.monster.tameable}}{{system.monster.tamers}}{{else}}nein{{/if}}</span></label>
            </div>
            <label class="hb-breit">Merkmale <input name="system.monster.traits" type="text" value="{{system.monster.traits}}" /></label>
            <label class="hb-breit">Lebensraum <input name="system.monster.habitat" type="text" value="{{system.monster.habitat}}" /></label>
            <label class="hb-breit">Besonderheit <textarea name="system.monster.special">{{system.monster.special}}</textarea></label>
          </section>
        {{else}}
          <section class="hb-figur">
            <div class="hb-slots hb-links">
              {{#each bogen.figur.links as |platz|}}
                <div class="hb-slot {{#if platz.item}}is-voll{{else}}is-leer{{/if}}" {{#if platz.item}}data-item-id="{{platz.item.id}}" data-rang="{{platz.item.rang}}" data-tooltip-html="{{platz.item.tooltip}}" draggable="true"{{/if}}>
                  {{#if platz.item}}<img src="{{platz.item.img}}" alt="" />{{/if}}
                  <span class="hb-slotname">{{platz.label}}</span>
                </div>
              {{/each}}
            </div>
            <div class="hb-person"><img src="{{profileImage}}" data-edit="img" title="Bild ändern" alt="" /></div>
            <div class="hb-slots hb-rechts">
              {{#each bogen.figur.rechts as |platz|}}
                <div class="hb-slot {{#if platz.item}}is-voll{{else}}is-leer{{/if}}" {{#if platz.item}}data-item-id="{{platz.item.id}}" data-rang="{{platz.item.rang}}" data-tooltip-html="{{platz.item.tooltip}}" draggable="true"{{/if}}>
                  {{#if platz.item}}<img src="{{platz.item.img}}" alt="" />{{/if}}
                  <span class="hb-slotname">{{platz.label}}</span>
                </div>
              {{/each}}
            </div>
          </section>
        {{/if}}

        <div class="hb-spalte">
          {{#if isNpc}}{{#if isGM}}
          <section class="hb-karte hb-nsc">
            <h3>NSC <small>nur für dich</small></h3>
            <div class="hb-nsc-zeile">
              <label>Level <input name="nscLevel" type="number" min="1" max="40" value="{{system.progression.level}}" /></label>
              <label>Schwerpunkt
                <select name="nscSchwerpunkt">
                  {{#each schwerpunkte as |s|}}<option value="{{s.key}}" {{#if s.selected}}selected{{/if}}>{{s.label}}</option>{{/each}}
                </select>
              </label>
              <button type="button" data-nsc-werte title="Setzt das Level und verteilt alle Wertpunkte nach Schwerpunkt neu"><i class="fa-solid fa-wand-magic-sparkles"></i> Werte verteilen</button>
            </div>
            <div class="hb-nsc-zeile">
              <button type="button" data-nsc-gespraech="gespraech"><i class="fa-solid fa-comment"></i> Sprechen</button>
              <button type="button" data-nsc-gespraech="handel"><i class="fa-solid fa-scale-balanced"></i> Handel</button>
              <button type="button" data-nsc-gespraech="quests"><i class="fa-solid fa-scroll"></i> Quests</button>
            </div>
          </section>
          {{/if}}{{/if}}
          <section class="hb-karte">
            <h3>Kampfwerte
              <span class="hb-pips" title="Aktion · Schnellaktion · Reaktion">
                <span class="hb-res hb-aktion {{#if aktionen.aktion}}is-bereit{{/if}}">A</span>
                <button type="button" class="hb-res hb-schnell {{#if aktionen.schnell}}is-bereit{{/if}}" data-toggle-action="quick" title="Schnellaktion">S</button>
                <button type="button" class="hb-res hb-reaktion {{#if aktionen.reaktion}}is-bereit{{/if}}" data-toggle-action="reaction" title="Reaktion">R</button>
              </span>
            </h3>
            <div class="hb-kampfwerte">
              <div class="hb-kw"><b>{{system.resources.hp.max}}</b><span>HP max</span></div>
              <div class="hb-kw"><b>{{system.derived.rw}}</b><span>Rüstwert</span></div>
              <div class="hb-kw"><b>{{system.derived.mr}}</b><span>Magieres.</span></div>
              <div class="hb-kw"><b>+{{system.derived.accBonus}}</b><span>Genauigk.-Bonus</span></div>
              <div class="hb-kw"><b>{{system.derived.block}}</b><span>Block</span></div>
              <div class="hb-kw"><b>{{system.derived.movement}}</b><span>Bewegung</span></div>
              <div class="hb-kw"><b>+{{system.derived.initiative}}</b><span>Initiative</span></div>
              {{#unless isMonster}}<div class="hb-kw"><b>{{inventoryUsed}}/{{inventoryMax}}</b><span>Inventar</span></div>{{/unless}}
              {{#if system.combat.defending}}<div class="hb-kw is-abwehr"><b>+2</b><span>Abwehr</span></div>{{/if}}
            </div>
          </section>

          {{#unless isMonster}}
            <section class="hb-karte hb-werte-karte {{#if punkte.knoepfe}}is-verteilen{{/if}}">
              <h3>Werte <span class="hb-punkte {{#if pointsOver}}is-over{{/if}}">verteilt {{system.derived.points.used}} / {{punkte.erlaubt}} · frei <b>{{punkte.frei}}</b></span></h3>
              {{#if isGM}}
                <div class="hb-attribute">
                  {{#each system.attributes as |attribute key|}}
                    <label class="hb-attr" title="{{attribute.label}}">
                      <span>{{attribute.abbr}}</span>
                      <input name="system.attributes.{{key}}.value" type="number" min="1" max="25" value="{{attribute.value}}" />
                    </label>
                  {{/each}}
                </div>
              {{else}}
                <div class="hb-attribute">
                  {{#each punkte.werte as |w|}}
                    <div class="hb-attr {{#if w.plus}}is-plus{{/if}}" title="{{w.label}}">
                      <span>{{w.abbr}}</span>
                      <b>{{w.wert}}</b>
                      {{#if ../punkte.knoepfe}}
                        <div class="hb-plusminus">
                          <button type="button" data-minus="{{w.key}}" {{#unless w.kannMinus}}disabled{{/unless}}>−</button>
                          <button type="button" data-plus="{{w.key}}" {{#unless w.kannPlus}}disabled{{/unless}}>+</button>
                        </div>
                      {{/if}}
                    </div>
                  {{/each}}
                </div>
                {{#if punkte.knoepfe}}
                  <div class="hb-verteilen">
                    <span>{{#if punkte.erstellung}}Bei der Erstellung höchstens +3 pro Wert. {{/if}}Deine Klasse zeigt sich, sobald du speicherst.</span>
                    <button type="button" data-punkte-zuruecksetzen {{#unless punkte.aenderung}}disabled{{/unless}}>Zurücksetzen</button>
                    <button type="button" class="hb-speichern" data-punkte-speichern {{#unless punkte.aenderung}}disabled{{/unless}}>Speichern</button>
                  </div>
                {{/if}}
              {{/if}}
            </section>

            <section class="hb-karte">
              <h3>Waffen</h3>
              <div class="hb-waffen">
                {{#each bogen.figur.waffen as |platz|}}
                  {{#if platz.gefaehrte}}
                    <div class="hb-slot is-voll hb-gefaehrte {{#if platz.gefaehrte.aufFeld}}is-feld{{/if}}" data-gefaehrte data-tooltip-html="{{platz.gefaehrte.tooltip}}">
                      <img src="{{platz.gefaehrte.img}}" alt="" />
                      {{#if platz.gefaehrte.badge}}<span class="hb-runden">{{platz.gefaehrte.badge}}</span>{{/if}}
                      <span class="hb-slotname">{{platz.label}}</span>
                    </div>
                  {{else}}
                    <div class="hb-slot {{#if platz.item}}is-voll{{else}}is-leer{{/if}}" {{#if platz.item}}data-item-id="{{platz.item.id}}" data-rang="{{platz.item.rang}}" data-tooltip-html="{{platz.item.tooltip}}" draggable="true"{{/if}}>
                      {{#if platz.item}}<img src="{{platz.item.img}}" alt="" />{{/if}}
                      <span class="hb-slotname">{{platz.label}}</span>
                    </div>
                  {{/if}}
                {{/each}}
                {{#each bogen.figur.weitere as |item|}}
                  <div class="hb-slot is-voll is-klein" data-item-id="{{item.id}}" data-rang="{{item.rang}}" data-tooltip-html="{{item.tooltip}}" draggable="true">
                    <img src="{{item.img}}" alt="" />
                    <span class="hb-slotname">Angelegt</span>
                  </div>
                {{/each}}
              </div>
            </section>
          {{/unless}}
        </div>
      </div>

      {{#unless isMonster}}
        <section class="hb-inventar">
          <div class="hb-invkopf">
            <div class="hb-filter">
              <button type="button" class="is-aktiv" data-filter="alle">Alles</button>
              <button type="button" data-filter="ausr">Ausrüstung</button>
              <button type="button" data-filter="verbrauch">Verbrauch</button>
              <button type="button" data-filter="material">Material</button>
              <button type="button" data-filter="orb">Skill-Orbs</button>
            </div>
            <div class="hb-kes">
              <span>Kes <b>{{kesText}}</b></span>
              <input data-gold-amount type="text" placeholder="z. B. 1 GK 20 SK" />
              <button type="button" data-give-gold title="An das markierte Ziel geben">Geben</button>
              {{#if isGM}}
                <input data-add-gold-amount type="text" placeholder="GM: +50 SK / −2 GK" />
                <button type="button" data-add-gold>Buchen</button>
              {{/if}}
            </div>
          </div>
          <div class="hb-raster">
            {{#each bogen.raster as |item|}}
              <div class="hb-feld {{#if item.orb}}is-orb{{/if}}" data-item-id="{{item.id}}" data-filter="{{item.filter}}" data-rang="{{item.rang}}" data-tooltip-html="{{item.tooltip}}" draggable="true">
                {{#if item.orb}}<span class="hb-orbkugel"></span>{{else}}<img src="{{item.img}}" alt="" />{{/if}}
                {{#if item.menge}}<span class="hb-anzahl">{{item.menge}}</span>{{/if}}
              </div>
            {{/each}}
            {{#each bogen.leereFelder}}<div class="hb-feld is-leer"></div>{{/each}}
          </div>
          <div class="hb-invfuss">
            <span>Klick auf einen Gegenstand: ausrüsten, benutzen, geben, wegwerfen. Skill-Orbs: untersuchen oder lernen.</span>
            {{#if isGM}}
              <span>
                <button type="button" data-geben="items">Gegenstand geben</button>
                <button type="button" data-import-json>JSON importieren</button>
              </span>
            {{/if}}
          </div>
        </section>

        <section class="hb-karte hb-worldskills">
          <h3>World-Skills <small>1W20 + Summe der drei Werte</small></h3>
          <div class="hb-ws-liste">
            {{#each worldSkills as |skill|}}
              <div class="hb-ws">
                <button type="button" data-roll-world-skill="{{skill.key}}" title="Würfeln">
                  <strong>{{skill.label}}</strong>
                  <small>{{skill.attributeLabels}}</small>
                </button>
                <input name="system.worldSkills.{{skill.key}}.bonus" type="number" value="{{skill.bonus}}" title="Bonus" />
                <b title="{{skill.base}} aus Werten{{#if skill.passive}} · +{{skill.passive}} passiv{{/if}}">{{skill.total}}</b>
              </div>
            {{/each}}
          </div>
        </section>
      {{/unless}}
    </div>

    <div class="tab" data-group="primary" data-tab="skills">
      <div class="hb-skillkopf">
        {{#unless isMonster}}
          <div class="hb-slotpips" >
            Skill-Slots
            {{#each slotPips as |voll|}}<span class="hb-pip {{#if voll}}is-voll{{/if}}"></span>{{/each}}
            <b>{{skillSlots.used}} / {{skillSlots.max}}</b> <small>Klassen-Skills zählen nicht</small>
          </div>
        {{/unless}}
        {{#if isGM}}<button type="button" class="hb-knopf" data-geben="skills">Skill geben</button>{{/if}}
      </div>

      <h3 class="hb-abschnitt">Aktive Skills <small>brauchen eine Aktion oder Schnellaktion</small></h3>
      <div class="hb-skills">
        {{#each bogen.skills.aktiv as |skill|}}
          <article class="hb-skill {{#if skill.istKlasse}}is-klasse{{/if}} {{#unless skill.canUse}}is-gesperrt{{/unless}}" data-item-id="{{skill.id}}" data-rang="{{skill.rang}}" draggable="true">
            <button type="button" class="hb-ikon" data-use-skill {{#unless skill.canUse}}{{#unless skill.isPending}}disabled{{/unless}}{{/unless}} title="{{#if skill.isPending}}Abbrechen{{else}}Einsetzen{{/if}}">
              <img src="{{skill.img}}" alt="" />
              {{#if skill.cooldown}}<span class="hb-cd">{{skill.cooldown}}</span>{{/if}}
              {{#if skill.isPending}}<span class="hb-cd">✕</span>{{/if}}
            </button>
            <div class="hb-skilltext">
              <h4><a data-edit-owned-item>{{skill.name}}</a>{{#if skill.rang}} <small class="hb-rang">{{skill.rang}}</small>{{/if}}{{#if skill.istKlasse}} <small class="hb-badge">Klasse</small>{{/if}}</h4>
              <div class="hb-tags">{{#each skill.tags as |tag|}}<span class="hb-tag {{tag.art}}">{{tag.text}}</span>{{/each}}</div>
              {{#if skill.beschreibung}}<p data-tooltip="{{skill.beschreibung}}">{{skill.beschreibung}}</p>{{/if}}
              {{#if skill.meisterung}}
                <div class="hb-lernen {{#if skill.meisterung.fertig}}is-fertig{{/if}}" data-tooltip="{{#if skill.meisterung.fertig}}Gemeistert{{else}}Bei 100 %{{/if}}: {{skill.meisterung.text}}">
                  <span class="hb-lernspur"><i style="width: {{skill.meisterung.wert}}%"></i></span>
                  <span class="hb-lernzahl">{{#if skill.meisterung.fertig}}★ gemeistert{{else}}{{skill.meisterung.wert}} %{{/if}}</span>
                </div>
              {{/if}}
            </div>
            {{#if ../isGM}}<button type="button" class="hb-weg" data-delete-skill title="Skill entfernen">✕</button>{{/if}}
          </article>
        {{else}}
          <p class="hb-leer">Keine aktiven Skills.</p>
        {{/each}}
      </div>

      <h3 class="hb-abschnitt">Passive Skills <small>wirken immer, keine Aktion nötig</small></h3>
      <div class="hb-skills">
        {{#each bogen.skills.passiv as |skill|}}
          <article class="hb-skill is-passiv {{#if skill.istKlasse}}is-klasse{{/if}}" data-item-id="{{skill.id}}" data-rang="{{skill.rang}}" draggable="true">
            <div class="hb-ikon"><img src="{{skill.img}}" alt="" /><span class="hb-dauer" title="Wirkt immer">∞</span></div>
            <div class="hb-skilltext">
              <h4><a data-edit-owned-item>{{skill.name}}</a>{{#if skill.rang}} <small class="hb-rang">{{skill.rang}}</small>{{/if}}{{#if skill.istKlasse}} <small class="hb-badge">Klasse</small>{{/if}}</h4>
              <div class="hb-tags">
                <span class="hb-tag passiv">Passiv · wirkt immer</span>
                {{#if skill.boni}}<span class="hb-tag wirkt" title="Schon in den Werten eingerechnet">{{skill.boni}}</span>{{/if}}
              </div>
              {{#if skill.beschreibung}}<p data-tooltip="{{skill.beschreibung}}">{{skill.beschreibung}}</p>{{/if}}
              {{#if skill.meisterung}}
                <div class="hb-lernen {{#if skill.meisterung.fertig}}is-fertig{{/if}}" data-tooltip="{{#if skill.meisterung.fertig}}Gemeistert{{else}}Bei 100 %{{/if}}: {{skill.meisterung.text}}">
                  <span class="hb-lernspur"><i style="width: {{skill.meisterung.wert}}%"></i></span>
                  <span class="hb-lernzahl">{{#if skill.meisterung.fertig}}★ gemeistert{{else}}{{skill.meisterung.wert}} %{{/if}}</span>
                </div>
              {{/if}}
            </div>
            {{#if ../isGM}}<button type="button" class="hb-weg" data-delete-skill title="Skill entfernen">✕</button>{{/if}}
          </article>
        {{else}}
          <p class="hb-leer">Keine passiven Skills.</p>
        {{/each}}
      </div>
    </div>

    {{#unless isMonster}}
      <div class="tab" data-group="primary" data-tab="insignia">
        <p class="hb-hinweis">Drei Slots, alle drei wirken. Insignien gibt der GM für Taten. Weitere Insignien ruhen und lassen sich bei einer langen Rast tauschen. Feste Werte im Text (z. B. „Naturkunde +3“, „Initiative +5“) rechnet das System selbst ein.</p>
        <div class="hb-insignien">
          {{#each insigniaSlots as |slot|}}
            <section class="hb-insignie {{#if slot.name}}is-voll{{else}}is-leer{{/if}} {{#if slot.farbe}}hi-rand-{{slot.farbe}}{{/if}}">
              <div class="hb-insbild">
                {{#if slot.image}}<img src="{{slot.image}}" alt="" {{#if ../isGM}}data-edit="system.insigniaSlots.{{slot.key}}.image" title="Bild ändern"{{/if}} />
                {{else}}{{#if ../isGM}}<img class="is-platzhalter" src="icons/svg/aura.svg" data-edit="system.insigniaSlots.{{slot.key}}.image" title="Bild wählen" alt="" />{{else}}<span class="hb-insleer">frei</span>{{/if}}{{/if}}
              </div>
              <span class="hb-slotnr">Slot {{slot.nr}}{{#if slot.rank}} · Rang {{slot.rank}}{{/if}}</span>
              {{#if ../isGM}}
                <div class="hb-inswahl">
                  <button type="button" data-insignie-waehlen="{{slot.key}}"><i class="fa-solid fa-list"></i> Aus Liste wählen</button>
                  {{#if slot.name}}<button type="button" data-insignie-leeren="{{slot.key}}" title="Slot leeren"><i class="fa-solid fa-xmark"></i></button>{{/if}}
                </div>
                <input class="hb-insname" name="system.insigniaSlots.{{slot.key}}.name" type="text" value="{{slot.name}}" placeholder="Name der Insignie" />
                <textarea name="system.insigniaSlots.{{slot.key}}.description" placeholder="Wirkung, z. B. „Naturkunde +2“ – Zahlen wie diese wirken automatisch">{{slot.description}}</textarea>
              {{else}}
                <h4>{{#if slot.name}}{{slot.name}}{{else if slot.description}}Insignie{{else}}Noch keine Insignie{{/if}}</h4>
                <p>{{slot.description}}</p>
              {{/if}}
              {{#if slot.name}}
                {{#if slot.wirkt}}<span class="hb-tag wirkt" title="Schon in den Werten eingerechnet">wirkt automatisch: {{slot.wirkt}}</span>
                {{else}}<span class="hb-tag">Wirkung am Tisch</span>{{/if}}
              {{/if}}
            </section>
          {{/each}}
        </div>
        <section class="hb-karte">
          <h3>Ruhende Insignien</h3>
          <textarea class="hb-ruhend" name="system.progression.insignia" placeholder="Insignien, die gerade nicht in einem Slot stecken" {{#unless isGM}}disabled{{/unless}}>{{system.progression.insignia}}</textarea>
        </section>
      </div>
    {{/unless}}

    <div class="tab" data-group="primary" data-tab="notes">
      <div class="hb-notizen">
        <div class="hb-spalte">
          {{#unless isMonster}}
            <section class="hb-karte">
              <h3>Profil</h3>
              <div class="hb-formular">
                <label>Spieler <input name="system.identity.player" type="text" value="{{system.identity.player}}" /></label>
                <label>Alter <input name="system.identity.age" type="text" value="{{system.identity.age}}" /></label>
                <label>Geschlecht <input name="system.identity.gender" type="text" value="{{system.identity.gender}}" /></label>
                <label>Job <input name="system.progression.job" type="text" value="{{system.progression.job}}" /></label>
                <label>Titel <input name="system.progression.title" type="text" value="{{system.progression.title}}" /></label>
              </div>
              {{#if isGM}}
                <p class="hb-klassenhinweis">Klasse nach Wertverteilung: <b>{{system.derived.suggestedClass}}</b>{{#if system.derived.suggestedClassEffect}}<br><small>{{system.derived.suggestedClassEffect}}</small>{{/if}}</p>
              {{else}}
                {{#if klasseAnzeige}}<p class="hb-klassenhinweis">Klasse: <b>{{klasseAnzeige}}</b>{{#if klasseEffekt}}<br><small>{{klasseEffekt}}</small>{{/if}}</p>{{/if}}
              {{/if}}
            </section>
            {{#if passivListe.length}}
              <section class="hb-karte">
                <h3>Wirkt gerade (passiv)</h3>
                <ul class="hb-wirkt">{{#each passivListe as |p|}}<li><b>{{p.name}}</b>{{#if p.text}} · {{p.text}}{{else}} · siehe Skilltext{{/if}}</li>{{/each}}</ul>
              </section>
            {{/if}}
          {{/unless}}
          {{#if isGM}}
            <details class="hb-karte hb-gm">
              <summary>GM: Boni (Klasse, Titel, Insignien)</summary>
              <div class="hb-formular">
                <label>HP <input name="system.bonuses.hp" type="number" value="{{system.bonuses.hp}}" /></label>
                <label>RW <input name="system.bonuses.rw" type="number" value="{{system.bonuses.rw}}" /></label>
                <label>MR <input name="system.bonuses.mr" type="number" value="{{system.bonuses.mr}}" /></label>
                <label>Blockwert <input name="system.bonuses.block" type="number" value="{{system.bonuses.block}}" /></label>
                <label>Genauigkeit <input name="system.bonuses.acc" type="number" value="{{system.bonuses.acc}}" /></label>
                <label>Schaden <input name="system.bonuses.damage" type="number" value="{{system.bonuses.damage}}" /></label>
                <label>Bewegung <input name="system.bonuses.movement" type="number" value="{{system.bonuses.movement}}" /></label>
                <label>Initiative <input name="system.bonuses.initiative" type="number" value="{{system.bonuses.initiative}}" /></label>
                <label>Inventar <input name="system.bonuses.inventory" type="number" value="{{system.bonuses.inventory}}" /></label>
                <label>Aktionen <input name="system.resources.actionPoints.max" type="number" value="{{system.resources.actionPoints.max}}" /></label>
              </div>
            </details>
          {{/if}}
        </div>
        <section class="hb-karte hb-notizfeld">
          <h3>Notizen</h3>
          <textarea name="system.identity.notes" placeholder="Hintergrund, Ziele, Kontakte, offene Fragen …">{{system.identity.notes}}</textarea>
        </section>
      </div>
    </div>
  </section>
</form>

<form class="{{cssClass}} hlw-sheet" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{profileImage}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields">
      <h1><input name="name" type="text" value="{{actor.name}}" placeholder="Charaktername" /></h1>
      {{#if isMonster}}
        <div class="identity-grid">
          <label>Rang <input name="system.monster.rank" type="text" value="{{system.monster.rank}}" /></label>
          <label>Rolle <input name="system.monster.role" type="text" value="{{system.monster.role}}" /></label>
          <label>Größe <input name="system.monster.size" type="text" value="{{system.monster.size}}" /></label>
          <label>Kategorie <input name="system.monster.category" type="text" value="{{system.monster.category}}" /></label>
          <label>Corrupted-Stufe <input name="system.monster.corrupted" type="number" value="{{system.monster.corrupted}}" /></label>
          <label>EXP <input name="system.monster.exp" type="text" value="{{system.monster.exp}}" /></label>
        </div>
      {{else}}
        <div class="identity-grid">
          <label>Spieler <input name="system.identity.player" type="text" value="{{system.identity.player}}" /></label>
          <label>Herkunft <input name="system.identity.origin" type="text" value="{{system.identity.origin}}" placeholder="A–D" /></label>
          <label>Level <input name="system.progression.level" type="number" value="{{system.progression.level}}" /></label>
          <label>EXP <span><input name="system.progression.exp" type="number" value="{{system.progression.exp}}" /> / {{#if system.derived.expNext}}{{system.derived.expNext}}{{else}}max{{/if}}</span></label>
          <label>Klasse <input name="system.progression.class" type="text" value="{{system.progression.class}}" placeholder="{{system.derived.suggestedClass}}" /></label>
          <label>Job <input name="system.progression.job" type="text" value="{{system.progression.job}}" /></label>
          <label>Titel <input name="system.progression.title" type="text" value="{{system.progression.title}}" /></label>
          <label>Insignie <input name="system.progression.insignia" type="text" value="{{system.progression.insignia}}" /></label>
        </div>
        <p class="hlw-class-hint" title="{{system.derived.suggestedClassEffect}}">Klasse nach Wertverteilung: <strong>{{system.derived.suggestedClass}}</strong></p>
      {{/if}}
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="main">Charakter</a>
    <a class="item" data-tab="skills">Skills</a>
    {{#unless isMonster}}<a class="item" data-tab="insignia">Insignien</a>{{/unless}}
    <a class="item" data-tab="inventory">Inventar</a>
    <a class="item" data-tab="notes">Notizen</a>
  </nav>

  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="main">
      <section class="resource-grid">
        <label>Lebenspunkte
          <span><input name="system.resources.hp.value" type="number" value="{{system.resources.hp.value}}" /> / {{system.resources.hp.max}}</span>
        </label>
        <label>Rüstwert (RW)<span><strong>{{system.derived.rw}}</strong></span></label>
        <label>Magieresistenz (MR)<span><strong>{{system.derived.mr}}</strong></span></label>
        <label>Blockwert<span><strong>{{system.derived.block}}</strong></span></label>
        <label>Initiative<span><strong>1W20 + {{system.derived.initiative}}</strong></span></label>
        <label>Bewegung<span><strong>{{system.derived.movement}} Felder</strong></span></label>
        {{#unless isMonster}}
          <label>Inventarplätze<span>{{inventoryUsed}} / {{system.resources.inventorySlots.max}}</span></label>
          <label>Korruption
            <span><input name="system.resources.corruption.value" type="number" value="{{system.resources.corruption.value}}" /> / 100 · {{system.derived.corruption.label}}</span>
          </label>
        {{/unless}}
      </section>

      <section class="action-grid">
        <div class="action-toggle {{#if canAct}}is-ready{{else}}is-spent{{/if}}">
          <strong>Aktion</strong>
          <span>{{system.resources.actionPoints.value}} / {{system.resources.actionPoints.max}}</span>
        </div>
        <button type="button" class="action-toggle {{#if system.actions.quick.available}}is-ready{{else}}is-spent{{/if}}" data-toggle-action="quick">
          <strong>Schnellaktion</strong>
          <span>{{#if system.actions.quick.available}}bereit{{else}}verbraucht{{/if}}</span>
        </button>
        <button type="button" class="action-toggle {{#if system.actions.reaction.available}}is-ready{{else}}is-spent{{/if}}" data-toggle-action="reaction">
          <strong>Reaktion</strong>
          <span>{{#if system.actions.reaction.available}}bereit{{else}}verbraucht{{/if}}</span>
        </button>
        <button type="button" class="action-toggle {{#if system.actions.movement.available}}is-ready{{else}}is-spent{{/if}}" data-toggle-action="movement">
          <strong>Bewegung</strong>
          <span>{{#if system.actions.movement.available}}bereit{{else}}verbraucht{{/if}}</span>
        </button>
        <button type="button" class="action-toggle end-turn" data-end-turn>
          <strong>Zug beenden</strong>
          <span>weiter</span>
        </button>
      </section>

      <section class="standard-actions">
        <h2>Standardaktionen</h2>
        <div class="action-grid">
          <button type="button" class="action-toggle {{#unless canAct}}is-spent{{/unless}}" data-standard-action="attack" {{#unless canAct}}disabled{{/unless}}>
            <strong>Normaler Angriff</strong>
            <span>Aktion</span>
          </button>
          <button type="button" class="action-toggle {{#unless canAct}}is-spent{{/unless}}" data-standard-action="item" {{#unless canAct}}disabled{{/unless}}>
            <strong>Gegenstand benutzen</strong>
            <span>Aktion</span>
          </button>
          <button type="button" class="action-toggle {{#unless canAct}}is-spent{{/unless}}" data-standard-action="defend" {{#unless canAct}}disabled{{/unless}}>
            <strong>Abwehrhaltung</strong>
            <span>RW und MR +2</span>
          </button>
        </div>
      </section>

      {{#if isMonster}}
        <section class="monster-panel">
          <h2>Bestiarium-Werte</h2>
          <div class="form-grid">
            <label>HP <input name="system.monster.hp" type="number" value="{{system.monster.hp}}" /></label>
            <label>RW <input name="system.monster.rw" type="number" value="{{system.monster.rw}}" /></label>
            <label>MR <input name="system.monster.mr" type="number" value="{{system.monster.mr}}" /></label>
            <label>Genauigkeit <input name="system.monster.acc" type="number" value="{{system.monster.acc}}" /></label>
            <label>Initiative <input name="system.monster.initiative" type="number" value="{{system.monster.initiative}}" /></label>
            <label>Bewegung <input name="system.monster.movement" type="number" value="{{system.monster.movement}}" /></label>
            <label>Reichweite <input name="system.monster.reach" type="number" value="{{system.monster.reach}}" /></label>
            <label>Probenwert <input name="system.monster.probe" type="number" value="{{system.monster.probe}}" /></label>
          </div>
          <label class="stacked">Merkmale <input name="system.monster.traits" type="text" value="{{system.monster.traits}}" /></label>
          <label class="stacked">Lebensraum <input name="system.monster.habitat" type="text" value="{{system.monster.habitat}}" /></label>
          <label class="stacked">Besonderheit <textarea name="system.monster.special">{{system.monster.special}}</textarea></label>
        </section>
      {{else}}
        <section class="two-column">
          <div>
            <h2>Werte</h2>
            <p class="hlw-points {{#if pointsOver}}is-over{{/if}}">Verteilt {{system.derived.points.used}} von {{system.derived.points.allowed}} · frei {{system.derived.points.free}}</p>
            <div class="attribute-grid">
              {{#each system.attributes as |attribute key|}}
                <label>
                  <span>{{attribute.abbr}}</span>
                  <small>{{attribute.label}}</small>
                  <input name="system.attributes.{{key}}.value" type="number" min="1" max="25" value="{{attribute.value}}" />
                </label>
              {{/each}}
            </div>
          </div>

          <div>
            <h2>World-Skills</h2>
            <div class="world-skill-list">
              {{#each worldSkills as |skill|}}
                <div class="world-skill-row">
                  <button type="button" data-roll-world-skill="{{skill.key}}">W20</button>
                  <div>
                    <strong>{{skill.label}}</strong>
                    <small>{{skill.attributeLabels}}</small>
                  </div>
                  <span>{{skill.base}}</span>
                  <input name="system.worldSkills.{{skill.key}}.bonus" type="number" value="{{skill.bonus}}" />
                  <strong>{{skill.total}}</strong>
                </div>
              {{/each}}
            </div>
          </div>
        </section>
      {{/if}}

      {{#if isGM}}
        <section class="bonus-panel">
          <h2>Boni (Klasse, Titel, Insignien, GM)</h2>
          <div class="resistance-grid">
            <label><span>HP</span><input name="system.bonuses.hp" type="number" value="{{system.bonuses.hp}}" /></label>
            <label><span>RW</span><input name="system.bonuses.rw" type="number" value="{{system.bonuses.rw}}" /></label>
            <label><span>MR</span><input name="system.bonuses.mr" type="number" value="{{system.bonuses.mr}}" /></label>
            <label><span>Blockwert</span><input name="system.bonuses.block" type="number" value="{{system.bonuses.block}}" /></label>
            <label><span>Genauigkeit</span><input name="system.bonuses.acc" type="number" value="{{system.bonuses.acc}}" /></label>
            <label><span>Schaden</span><input name="system.bonuses.damage" type="number" value="{{system.bonuses.damage}}" /></label>
            <label><span>Bewegung</span><input name="system.bonuses.movement" type="number" value="{{system.bonuses.movement}}" /></label>
            <label><span>Initiative</span><input name="system.bonuses.initiative" type="number" value="{{system.bonuses.initiative}}" /></label>
            <label><span>Inventar</span><input name="system.bonuses.inventory" type="number" value="{{system.bonuses.inventory}}" /></label>
            <label><span>Aktionen</span><input name="system.resources.actionPoints.max" type="number" value="{{system.resources.actionPoints.max}}" /></label>
          </div>
        </section>
      {{/if}}
    </div>

    <div class="tab" data-group="primary" data-tab="skills">
      <h2>Spieler- und Klassenskills</h2>
      <section class="hlw-skill-kopf">
        <span>Skill-Slots {{skillSlots.used}} / {{skillSlots.max}} <small>(Klassen-Skills zählen nicht)</small></span>
        {{#if isGM}}<button type="button" data-geben="skills">Skill geben</button>{{/if}}
      </section>
      <ol class="item-list">
        {{#each itemsByType.skills as |item|}}
          <li class="item-row {{#unless item.canUse}}is-disabled{{/unless}}" data-item-id="{{item.id}}" draggable="true">
            <button type="button" data-use-skill {{#unless item.canUse}}disabled{{/unless}}>{{#if item.isPending}}Abbrechen{{else}}Nutzen{{/if}}</button>
            <strong>{{item.name}}</strong>
            <span>{{item.system.skillType}}</span>
            <span>{{item.activationLabel}}</span>
            <span>{{item.system.element}}</span>
            <span>CD {{item.system.cooldown.value}} / {{item.system.cooldown.max}}</span>
            <span>Range {{item.system.range}}</span>
            <span>{{item.system.damage}}</span>
            {{#if ../isGM}}<button type="button" class="danger-button" data-delete-skill>X</button>{{/if}}
          </li>
        {{/each}}
      </ol>
    </div>

    <div class="tab" data-group="primary" data-tab="insignia">
      <h2>Insignien</h2>
      <div class="insignia-grid">
        {{#each insigniaSlots as |slot|}}
          <section class="insignia-slot">
            <label class="insignia-active"><input name="system.progression.activeInsignia" type="radio" value="{{slot.key}}" {{checked slot.active}} /> Aktiv</label>
            <img src="{{slot.image}}" data-edit="system.insigniaSlots.{{slot.key}}.image" title="{{slot.name}}" />
            <label>Name <input name="system.insigniaSlots.{{slot.key}}.name" type="text" value="{{slot.name}}" /></label>
            <label>Bild <input name="system.insigniaSlots.{{slot.key}}.image" type="text" value="{{slot.image}}" /></label>
            <label>Beschreibung <textarea name="system.insigniaSlots.{{slot.key}}.description">{{slot.description}}</textarea></label>
          </section>
        {{/each}}
      </div>
    </div>

    <div class="tab" data-group="primary" data-tab="inventory">
      <h2>Inventar</h2>
      <section class="inventory-gold-bar">
        <div>
          <span>Kes</span>
          <strong>{{kesText}}</strong>
        </div>
        <div>
          <span>Inventar</span>
          <strong>{{inventoryUsed}} / {{inventoryMax}}</strong>
        </div>
        <label>Kes geben
          <span><input data-gold-amount type="text" placeholder="z. B. 1 GK 20 SK" /><button type="button" data-give-gold>Geben</button></span>
        </label>
        {{#if isGM}}
          <label>GM Kes +/−
            <span><input data-add-gold-amount type="text" placeholder="z. B. 50 SK oder -2 GK" /><button type="button" data-add-gold>Buchen</button></span>
          </label>
          <button type="button" class="inventory-import-button" data-geben="items">Gegenstand geben</button>
          <button type="button" class="inventory-import-button" data-import-json>JSON importieren</button>
        {{/if}}
      </section>
      <h3>Waffen</h3>
      <ol class="item-list">
        {{#each itemsByType.weapons as |item|}}
          <li class="item-row inventory-row" data-item-id="{{item.id}}">
            <input type="checkbox" data-toggle-equipped {{checked item.equipped}} title="Ausgeruestet" />
            <img src="{{item.img}}" alt="" />
            <strong>{{item.name}}</strong>
            <span>{{item.damageCategoryLabel}}</span>
            <span>{{item.damageTypeLabel}}</span>
            <span>{{item.system.damage}}</span>
            <span>R {{item.system.range}}</span>
            <button type="button" data-show-item-details>Details</button>
            <button type="button" data-edit-owned-item>Bearbeiten</button>
            <button type="button" data-give-owned-item>Geben</button>
            <button type="button" data-consume-owned-item>Verbr.</button>
            <button type="button" data-discard-owned-item>Weg</button>
          </li>
        {{/each}}
      </ol>
      <h3>Rüstung</h3>
      <ol class="item-list">
        {{#each itemsByType.armor as |item|}}
          <li class="item-row inventory-row" data-item-id="{{item.id}}">
            <input type="checkbox" data-toggle-equipped {{checked item.equipped}} title="Ausgeruestet" />
            <img src="{{item.img}}" alt="" />
            <strong>{{item.name}}</strong>
            <span>HP {{item.system.hp}}{{#if item.system.hpDice}} ({{item.system.hpDice}}){{/if}}</span>
            <span>{{item.system.slot}}</span>
            <button type="button" data-show-item-details>Details</button>
            <button type="button" data-edit-owned-item>Bearbeiten</button>
            <button type="button" data-give-owned-item>Geben</button>
            <button type="button" data-consume-owned-item>Verbr.</button>
            <button type="button" data-discard-owned-item>Weg</button>
          </li>
        {{/each}}
      </ol>
      <h3>Ausrüstung</h3>
      <ol class="item-list">
        {{#each itemsByType.equipment as |item|}}
          <li class="item-row inventory-row" data-item-id="{{item.id}}">
            <input type="checkbox" data-toggle-equipped {{checked item.equipped}} title="Ausgeruestet" />
            <img src="{{item.img}}" alt="" />
            <strong>{{item.name}}</strong>
            <span>{{item.system.slot}}</span>
            <span>{{item.system.effect}}</span>
            <button type="button" data-show-item-details>Details</button>
            <button type="button" data-edit-owned-item>Bearbeiten</button>
            <button type="button" data-give-owned-item>Geben</button>
            <button type="button" data-consume-owned-item>Verbr.</button>
            <button type="button" data-discard-owned-item>Weg</button>
          </li>
        {{/each}}
      </ol>
      <h3>Accessories</h3>
      <ol class="item-list">
        {{#each itemsByType.accessories as |item|}}
          <li class="item-row inventory-row" data-item-id="{{item.id}}">
            <input type="checkbox" data-toggle-equipped {{checked item.equipped}} title="Ausgeruestet" />
            <img src="{{item.img}}" alt="" />
            <strong>{{item.name}}</strong>
            <span>Rang {{item.system.rank}}</span>
            <span>{{item.system.effect}}</span>
            <button type="button" data-show-item-details>Details</button>
            <button type="button" data-edit-owned-item>Bearbeiten</button>
            <button type="button" data-give-owned-item>Geben</button>
            <button type="button" data-consume-owned-item>Verbr.</button>
            <button type="button" data-discard-owned-item>Weg</button>
          </li>
        {{/each}}
      </ol>
      <h3>Verbrauchbares & Material</h3>
      <ol class="item-list">
        {{#each itemsByType.consumables as |item|}}
          <li class="item-row inventory-row" data-item-id="{{item.id}}">
            <span></span>
            <img src="{{item.img}}" alt="" />
            <strong>{{item.name}}</strong>
            <span>x{{item.system.quantity}}</span>
            <span>{{item.system.effect}}</span>
            <button type="button" data-show-item-details>Details</button>
            <button type="button" data-edit-owned-item>Bearbeiten</button>
            <button type="button" data-give-owned-item>Geben</button>
            <button type="button" data-consume-owned-item>Verbr.</button>
            <button type="button" data-discard-owned-item>Weg</button>
          </li>
        {{/each}}
        {{#each itemsByType.materials as |item|}}
          <li class="item-row inventory-row" data-item-id="{{item.id}}">
            <span></span>
            <img src="{{item.img}}" alt="" />
            <strong>{{item.name}}</strong>
            <span>x{{item.system.quantity}}</span>
            <span>{{item.system.source}}</span>
            <button type="button" data-show-item-details>Details</button>
            <button type="button" data-edit-owned-item>Bearbeiten</button>
            <button type="button" data-give-owned-item>Geben</button>
            <button type="button" data-consume-owned-item>Verbr.</button>
            <button type="button" data-discard-owned-item>Weg</button>
          </li>
        {{/each}}
      </ol>
      <h3>Naturgegenstände</h3>
      <ol class="item-list">
        {{#each itemsByType.natural as |item|}}
          <li class="item-row inventory-row" data-item-id="{{item.id}}">
            <span></span>
            <img src="{{item.img}}" alt="" />
            <strong>{{item.name}}</strong>
            <span>x{{item.system.quantity}}</span>
            <span>{{item.system.source}}</span>
            <button type="button" data-show-item-details>Details</button>
            <button type="button" data-edit-owned-item>Bearbeiten</button>
            <button type="button" data-give-owned-item>Geben</button>
            <button type="button" data-consume-owned-item>Verbr.</button>
            <button type="button" data-discard-owned-item>Weg</button>
          </li>
        {{/each}}
      </ol>
      <h3>Mineralien</h3>
      <ol class="item-list">
        {{#each itemsByType.minerals as |item|}}
          <li class="item-row inventory-row" data-item-id="{{item.id}}">
            <span></span>
            <img src="{{item.img}}" alt="" />
            <strong>{{item.name}}</strong>
            <span>x{{item.system.quantity}}</span>
            <span>{{item.system.source}}</span>
            <button type="button" data-show-item-details>Details</button>
            <button type="button" data-edit-owned-item>Bearbeiten</button>
            <button type="button" data-give-owned-item>Geben</button>
            <button type="button" data-consume-owned-item>Verbr.</button>
            <button type="button" data-discard-owned-item>Weg</button>
          </li>
        {{/each}}
      </ol>
      <h3>Müll</h3>
      <ol class="item-list">
        {{#each itemsByType.junk as |item|}}
          <li class="item-row inventory-row" data-item-id="{{item.id}}">
            <span></span>
            <img src="{{item.img}}" alt="" />
            <strong>{{item.name}}</strong>
            <span>x{{item.system.quantity}}</span>
            <span>{{item.system.source}}</span>
            <button type="button" data-show-item-details>Details</button>
            <button type="button" data-edit-owned-item>Bearbeiten</button>
            <button type="button" data-give-owned-item>Geben</button>
            <button type="button" data-consume-owned-item>Verbr.</button>
            <button type="button" data-discard-owned-item>Weg</button>
          </li>
        {{/each}}
      </ol>
      <h3>Essen & Trinken</h3>
      <ol class="item-list">
        {{#each itemsByType.foodDrink as |item|}}
          <li class="item-row inventory-row" data-item-id="{{item.id}}">
            <span></span>
            <img src="{{item.img}}" alt="" />
            <strong>{{item.name}}</strong>
            <span>x{{item.system.quantity}}</span>
            <span>{{item.system.effect}}</span>
            <button type="button" data-show-item-details>Details</button>
            <button type="button" data-edit-owned-item>Bearbeiten</button>
            <button type="button" data-give-owned-item>Geben</button>
            <button type="button" data-consume-owned-item>Verbr.</button>
            <button type="button" data-discard-owned-item>Weg</button>
          </li>
        {{/each}}
      </ol>
    </div>

    <div class="tab" data-group="primary" data-tab="notes">
      <h2>Charakternotizen</h2>
      <textarea name="system.identity.notes">{{system.identity.notes}}</textarea>
    </div>
  </section>
</form>

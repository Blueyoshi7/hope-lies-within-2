<form class="{{cssClass}} hlw-sheet" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
      <h1><input name="name" type="text" value="{{item.name}}" placeholder="Name" /></h1>
      <div class="identity-grid">
        <label>Quelle <input name="system.source" type="text" value="{{system.source}}" /></label>
        <label>Rang <input name="system.rank" type="text" value="{{system.rank}}" /></label>
        {{#if isGM}}<label>Marktwert (SK) <span><input name="system.priceSk" type="number" value="{{system.priceSk}}" /> {{priceText}}</span></label>{{/if}}
      </div>
    </div>
  </header>

  {{#if isSkill}}
    <section class="form-grid">
      <label>Skill-Art <input name="system.skillType" type="text" value="{{system.skillType}}" /></label>
      <label>Aktivierung
        <select name="system.activation">
          {{#select system.activation}}
            <option value="active">Aktiv</option>
            <option value="passive">Passiv</option>
          {{/select}}
        </select>
      </label>
      <label>Kosten <input name="system.cost" type="text" value="{{system.cost}}" /></label>
      <label>Einsatz
        <select name="system.castTime">
          {{#select system.castTime}}
            <option value="action">Aktion</option>
            <option value="quick">Schnellaktion</option>
          {{/select}}
        </select>
      </label>
      <label>Kategorie
        <select name="system.damageCategory">
          {{#select system.damageCategory}}
            <option value="physical">Physisch</option>
            <option value="magical">Magisch</option>
          {{/select}}
        </select>
      </label>
      <label>Schadenstyp
        <select name="system.damageType">
          {{#select system.damageType}}
            <option value="slash">Klinge / Schnitt</option>
            <option value="pierce">Stich</option>
            <option value="blunt">Stumpf</option>
            <option value="fire">Feuer</option>
            <option value="ice">Eis</option>
            <option value="lightning">Blitz</option>
            <option value="earth">Erde</option>
            <option value="wind">Wind</option>
            <option value="holy">Heilig</option>
            <option value="shadow">Schatten</option>
            <option value="magic">Magie</option>
          {{/select}}
        </select>
      </label>
      <label>Range <input name="system.range" type="text" value="{{system.range}}" /></label>
      <label>Schaden / Heilung (Formel) <input name="system.damage" type="text" value="{{system.damage}}" /></label>
      <label>Angabe laut Liste <input name="system.damageText" type="text" value="{{system.damageText}}" /></label>
      <label>Cooldown <span><input name="system.cooldown.value" type="number" value="{{system.cooldown.value}}" /> / <input name="system.cooldown.max" type="number" value="{{system.cooldown.max}}" /></span></label>
      <label>Primaer <input name="system.scaling.primary" type="text" value="{{system.scaling.primary}}" /></label>
      <label>Sekundaer <input name="system.scaling.secondary" type="text" value="{{system.scaling.secondary}}" /></label>
      <label>Tertiaer <input name="system.scaling.tertiary" type="text" value="{{system.scaling.tertiary}}" /></label>
    </section>
    {{#if isPassive}}
      <h3>Passiv: wirkt immer</h3>
      <p class="hlw-passiv-hinweis">{{#if passivText}}Wirkt gerade: <strong>{{passivText}}</strong>. {{/if}}Trägt der GM hier Zahlen ein, ersetzen sie die Werte aus dem Skilltext.</p>
      <section class="form-grid">
        <label>HP <input name="system.bonuses.hp" type="number" value="{{system.bonuses.hp}}" /></label>
        <label>HP pro Level <input name="system.bonuses.hpPerLevel" type="number" value="{{system.bonuses.hpPerLevel}}" /></label>
        <label>Rüstwert <input name="system.bonuses.rw" type="number" value="{{system.bonuses.rw}}" /></label>
        <label>Magieresistenz <input name="system.bonuses.mr" type="number" value="{{system.bonuses.mr}}" /></label>
        <label>Blockwert <input name="system.bonuses.block" type="number" value="{{system.bonuses.block}}" /></label>
        <label>Genauigkeit <input name="system.bonuses.acc" type="number" value="{{system.bonuses.acc}}" /></label>
        <label>Schaden <input name="system.bonuses.damageBonus" type="number" value="{{system.bonuses.damageBonus}}" /></label>
        <label>Bewegung <input name="system.bonuses.movement" type="number" value="{{system.bonuses.movement}}" /></label>
        <label>Initiative <input name="system.bonuses.initiative" type="number" value="{{system.bonuses.initiative}}" /></label>
      </section>
    {{/if}}
    <label class="stacked">Effekt
      <textarea name="system.effect">{{system.effect}}</textarea>
    </label>
  {{else}}
    <section class="form-grid">
      <label>Anzahl <input name="system.quantity" type="number" value="{{system.quantity}}" /></label>
      {{#if isWeapon}}
        <label>Waffenart
          <select name="system.weaponClass">
            {{#select system.weaponClass}}
              <option value="melee">Nahkampf (STR oder DEX)</option>
              <option value="ranged">Fernkampf (AGL)</option>
              <option value="magic">Magisch (INT)</option>
              <option value="monster">Monster</option>
            {{/select}}
          </select>
        </label>
      {{/if}}
      {{#if isArmor}}
        <label>HP-Würfel <span><input name="system.hpDice" type="text" value="{{system.hpDice}}" />{{#if isGM}}<button type="button" data-roll-item-hp>Würfeln</button>{{/if}}</span></label>
        <label>HP (gewürfelt) <input name="system.hp" type="number" value="{{system.hp}}" /></label>
      {{/if}}
      <label>Slot <input name="system.slot" type="text" value="{{system.slot}}" /></label>
      <label>Kategorie
        <select name="system.damageCategory">
          {{#select system.damageCategory}}
            <option value="physical">Physisch</option>
            <option value="magical">Magisch</option>
          {{/select}}
        </select>
      </label>
      <label>Schadenstyp
        <select name="system.damageType">
          {{#select system.damageType}}
            <option value="slash">Klinge / Schnitt</option>
            <option value="pierce">Stich</option>
            <option value="blunt">Stumpf</option>
            <option value="fire">Feuer</option>
            <option value="ice">Eis</option>
            <option value="lightning">Blitz</option>
            <option value="earth">Erde</option>
            <option value="wind">Wind</option>
            <option value="holy">Heilig</option>
            <option value="shadow">Schatten</option>
            <option value="magic">Magie</option>
          {{/select}}
        </select>
      </label>
      <label>Schaden <input name="system.damage" type="text" value="{{system.damage}}" /></label>
      <label>Range <input name="system.range" type="text" value="{{system.range}}" /></label>
      <label>Ausgerüstet <input name="system.equipped" type="checkbox" {{checked system.equipped}} /></label>
    </section>
    <h3>Boni, wenn ausgerüstet</h3>
    <section class="form-grid">
      <label>Rüstwert <input name="system.bonuses.rw" type="number" value="{{system.bonuses.rw}}" /></label>
      <label>Magieresistenz <input name="system.bonuses.mr" type="number" value="{{system.bonuses.mr}}" /></label>
      <label>Blockwert <input name="system.bonuses.block" type="number" value="{{system.bonuses.block}}" /></label>
      <label>Genauigkeit <input name="system.bonuses.acc" type="number" value="{{system.bonuses.acc}}" /></label>
      <label>Schaden <input name="system.bonuses.damageBonus" type="number" value="{{system.bonuses.damageBonus}}" /></label>
      <label>Magischer Schaden <input name="system.bonuses.magicBonus" type="number" value="{{system.bonuses.magicBonus}}" /></label>
      <label>Bewegung <input name="system.bonuses.movement" type="number" value="{{system.bonuses.movement}}" /></label>
      <label>Initiative <input name="system.bonuses.initiative" type="number" value="{{system.bonuses.initiative}}" /></label>
    </section>
    <label class="stacked">Effekt
      <textarea name="system.effect">{{system.effect}}</textarea>
    </label>
  {{/if}}

  <label class="stacked">Beschreibung
    <textarea name="system.description">{{system.description}}</textarea>
  </label>

  {{#if isGM}}
    <footer class="item-sheet-actions">
      <button type="button" class="danger-button" data-delete-item>Item löschen</button>
    </footer>
  {{/if}}
</form>
